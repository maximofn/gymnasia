{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gymnasia.maximofn.com/schemas/catalogs/ejercicio.schema.json",
  "title": "Ejercicio",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "image_male",
    "image_female",
    "muscle_group",
    "secondary_muscles",
    "equipment",
    "difficulty",
    "instructions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "image_male": {
      "type": "string",
      "pattern": "^images/[a-z0-9]+(?:-[a-z0-9]+)*-male\\.webp$"
    },
    "image_female": {
      "type": "string",
      "pattern": "^images/[a-z0-9]+(?:-[a-z0-9]+)*-female\\.webp$"
    },
    "muscle_group": {
      "type": "string",
      "minLength": 1
    },
    "secondary_muscles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "equipment": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "type": "string",
      "minLength": 1
    },
    "instructions": {
      "type": "string",
      "minLength": 1
    }
  }
}
