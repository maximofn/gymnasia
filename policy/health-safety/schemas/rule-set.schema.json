{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gymnasia.local/schemas/health-safety-rule-set.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rules"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://gymnasia.local/schemas/health-safety-rule.json" }
    }
  }
}
