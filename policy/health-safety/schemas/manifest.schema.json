{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gymnasia.local/schemas/health-safety-manifest.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyVersion",
    "publishedStatuses",
    "professionalReviewRequiredForClosure",
    "requiredCategories",
    "requiredPublishedRuleIds",
    "currentRelease"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "policyVersion": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]+$" },
    "publishedStatuses": {
      "type": "array",
      "const": ["provisional", "approved"]
    },
    "professionalReviewRequiredForClosure": { "const": true },
    "requiredCategories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" }
    },
    "requiredPublishedRuleIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^HS-[A-Z]+(?:-[A-Z]+)*-[0-9]{3}$" }
    },
    "currentRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "changedRuleIds"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]+$" },
        "changedRuleIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^HS-[A-Z]+(?:-[A-Z]+)*-[0-9]{3}$" }
        }
      }
    }
  }
}
