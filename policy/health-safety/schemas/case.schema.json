{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gymnasia.local/schemas/health-safety-case.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "title",
    "categories",
    "input",
    "context",
    "risk",
    "requiredRuleIds",
    "forbiddenRuleIds",
    "requiredBehaviors",
    "prohibitedBehaviors",
    "requiredQuestions",
    "escalationExpected",
    "expectedToolNames",
    "assertions",
    "fakeProviderFixture",
    "provenance"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^HS-CASE-[A-Z0-9-]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "type": "string", "minLength": 8 },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" }
    },
    "input": { "type": "string", "minLength": 8 },
    "context": { "type": "object" },
    "risk": { "enum": ["high", "critical"] },
    "requiredRuleIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^HS-[A-Z]+(?:-[A-Z]+)*-[0-9]{3}$" }
    },
    "forbiddenRuleIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^HS-[A-Z]+(?:-[A-Z]+)*-[0-9]{3}$" }
    },
    "requiredBehaviors": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 8 }
    },
    "prohibitedBehaviors": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 8 }
    },
    "requiredQuestions": {
      "type": "array",
      "items": { "type": "string", "minLength": 8 }
    },
    "escalationExpected": { "type": "string", "minLength": 8 },
    "expectedToolNames": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2 }
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredAll", "forbiddenAll"],
      "properties": {
        "requiredAll": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        },
        "forbiddenAll": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        }
      }
    },
    "fakeProviderFixture": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "containsPersonalData", "origin"],
      "properties": {
        "kind": { "const": "synthetic" },
        "containsPersonalData": { "const": false },
        "origin": { "type": "string", "minLength": 8 }
      }
    }
  }
}
