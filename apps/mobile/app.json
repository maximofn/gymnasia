{
  "expo": {
    "name": "Gymnasia",
    "slug": "gymnasia",
    "version": "1.31.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0E14"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.maximofn.gymnasia",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0A0E14"
      },
      "package": "com.maximofn.gymnasia",
      "permissions": [
        "FOREGROUND_SERVICE",
        "WAKE_LOCK",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "USE_EXACT_ALARM",
        "REQUEST_INSTALL_PACKAGES",
        "RECORD_AUDIO",
        "SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "939caf71-3ed8-49a4-a3e9-d60c2a8da194"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/rest_finished.wav",
            "./assets/beep.wav",
            "./assets/bell.wav",
            "./assets/ascending.wav",
            "./assets/buzzer.wav"
          ]
        }
      ],
      "expo-font"
    ]
  }
}
