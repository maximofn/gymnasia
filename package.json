{
  "name": "gymnasia",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:mobile": "npm --workspace apps/mobile run start",
    "sync:health-safety": "node scripts/health-safety/sync.mjs --write && npm run sync:chat-prompt",
    "check:health-safety": "node scripts/health-safety/check.mjs",
    "test:health-safety": "node --test scripts/health-safety/*.test.mjs",
    "report:health-safety": "node scripts/health-safety/report.mjs",
    "sync:chat-prompt": "node apps/mobile/scripts/sync-chat-system-prompt.mjs --write",
    "check:chat-prompt": "node apps/mobile/scripts/sync-chat-system-prompt.mjs --check",
    "sync:prompt-policy": "node scripts/prompt-policy/generate.mjs --write",
    "check:prompt-policy": "node scripts/prompt-policy/generate.mjs --check",
    "test:prompt-policy": "node --test scripts/prompt-policy/*.test.mjs scripts/policy-promotion/*.test.mjs",
    "prepare:policy-snapshot": "node scripts/policy-promotion/prepare-policy-snapshot.mjs",
    "policy:key:init-root": "node scripts/policy-promotion/sign-policy.mjs key-init-root",
    "policy:key:init-signer": "node scripts/policy-promotion/sign-policy.mjs key-init-signer",
    "policy:bundle:sign": "node scripts/policy-promotion/sign-policy.mjs bundle-sign",
    "policy:bundle:check": "node scripts/policy-promotion/sign-policy.mjs bundle-check",
    "policy:activation:sign": "node scripts/policy-promotion/sign-policy.mjs activation-sign",
    "policy:promote": "node scripts/policy-promotion/sign-policy.mjs promote",
    "sync:policy-trust": "node scripts/policy-promotion/render-trusted-roots.mjs --write",
    "check:policy-trust": "node scripts/policy-promotion/render-trusted-roots.mjs",
    "check:android-permissions": "node scripts/android-permissions/check.mjs --check",
    "test:android-permissions": "node --test scripts/android-permissions/*.test.mjs",
    "verify:production-source": "node scripts/production-release/verify-source.mjs",
    "verify:production-artifact": "node scripts/production-release/verify-artifact.mjs",
    "prepare:production-version": "node scripts/production-release/release-version.mjs prepare",
    "check:production-version": "node scripts/production-release/release-version.mjs check",
    "release:transaction": "node scripts/production-release/release-transaction.mjs",
    "test:production-release": "node --test scripts/production-release/*.test.mjs",
    "check:data-inventory": "node scripts/data-inventory/check.mjs --check",
    "test:data-inventory": "node --test scripts/data-inventory/*.test.mjs",
    "sync:legal": "node scripts/legal/generate.mjs --write",
    "check:legal": "node scripts/legal/generate.mjs --check",
    "test:legal": "node --test scripts/legal/*.test.mjs",
    "test": "npm run test:deterministic && npm run test:dev-store",
    "test:deterministic": "npm --workspace apps/mobile run test:deterministic",
    "check:dev-store": "node scripts/dev-store/check.mjs",
    "test:dev-store": "npm run check:dev-store && node --test scripts/dev-store/*.test.mjs",
    "test:dev-store:e2e": "node apps/mobile/scripts/dev-store.e2e.mjs",
    "test:llm": "npm --workspace apps/mobile run test:llm",
    "test:agent:e2e": "node apps/mobile/scripts/agent-chat.e2e.mjs && node apps/mobile/scripts/development-provider.e2e.mjs",
    "test:update-removal:e2e": "node apps/mobile/scripts/update-removal.e2e.mjs",
    "test:data-deletion:e2e": "node apps/mobile/scripts/local-data-deletion.e2e.mjs",
    "test:privacy:e2e": "node apps/mobile/scripts/privacy-policy.e2e.mjs",
    "sync:catalogs": "node scripts/catalogs/generate.mjs --write",
    "check:catalogs": "node scripts/catalogs/generate.mjs --check",
    "test:catalogs": "node --test scripts/catalogs/*.test.mjs",
    "test:catalogs:e2e": "node apps/mobile/scripts/catalogs.e2e.mjs",
    "generate:store-listing": "node scripts/store-listing/generate-assets.mjs",
    "check:store-listing": "node scripts/store-listing/check.mjs",
    "test:store-listing": "node --test scripts/store-listing/*.test.mjs",
    "test:train:e2e": "node apps/mobile/scripts/train-usability.e2e.mjs",
    "test:diet:e2e": "node apps/mobile/scripts/diet-validation.e2e.mjs",
    "test:storage-recovery:e2e": "node apps/mobile/scripts/storage-recovery.e2e.mjs",
    "test:user-preferences:e2e": "node apps/mobile/scripts/user-preferences.e2e.mjs",
    "test:train:e2e:headed": "TRAIN_E2E_HEADLESS=0 npm run test:train:e2e",
    "test:openwiki": "node --test ops/openwiki-automation-template/tests/*.test.mjs",
    "test:board": "node --test arquitectura-agente/tests/board-data.test.mjs",
    "test:board:e2e": "node arquitectura-agente/tests/board.e2e.mjs",
    "test:board:e2e:headed": "BOARD_E2E_HEADLESS=0 npm run test:board:e2e"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "fast-check": "^4.9.0",
    "playwright": "^1.58.2",
    "sharp": "^0.35.4",
    "vitest": "^4.1.10"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
