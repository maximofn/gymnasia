    {
      "id": "claim_8a35c63286dc4c01898f12f3c92d24a8",
      "statement": "El efecto de persistencia posterior a cambios React comparte la cola del runtime, omite snapshots obsoletos y, ante un commit ambiguo o bloqueo de recuperación, deshidrata la aplicación y vuelve a inspeccionar el almacén; por ello no convierte `update()` en una confirmación durable esperable por su llamador.",
      "evidence": [
        {
          "resource": "repo://apps/mobile/App.tsx#L4263-L4302",
          "version": "repo-lines-v1:sha256:5184780e56c1b0a56be8531f09737e2062f431782c2c015e0e0857614d64e3ec:"
        }
      ]
